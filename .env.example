# KaburAjaDulu.AI — Environment Variables
# Copy this file to .env and fill in the values

# Gemini API Key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# App Settings
APP_NAME=KaburAjaDulu.AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# Model Artifacts Path (relative to project root)
ARTIFACTS_DIR=artifacts

# Server
HOST=0.0.0.0
PORT=8000
